{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LevelUp",
  "version": "8.1.1",
  "identifier": "info.lvelup.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/levelup-server"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGNDNDQzE5QTk5RTE0OEIKUldTTEZKNnBHY3hEUDhIQ053NUdoeDRRcGdWTE4zOExtZTRHRVBUY3doZXhtM25IenkvRlg0d0EK",
      "endpoints": ["https://github.com/JGtm/LevelUp/releases/download/updates/latest.json"]
    }
  }
}
