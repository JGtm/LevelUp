{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    // DOM requis : le code passe dans page.evaluate(() => ...) s'execute dans le
    // navigateur (document, window, localStorage, fetch, getComputedStyle, Node...).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    // node pour process.env (E2E_API_URL, CI, E2E_SYNTHETIC_DEMO...). Playwright
    // (@playwright/test) est importe explicitement -> pas de types globals a ajouter.
    // skipLibCheck neutralise les conflits d'identifiants globals node<->DOM (fetch...).
    "types": ["node"],
    "skipLibCheck": true,

    // Resolution alignee sur l'execution esbuild de Playwright : imports ESM
    // extensionless resolus en .ts (aucune spec n'importe avec extension .ts).
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    // Meme rigueur que tsconfig.app.json (le repo n'active pas `strict`).
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // Specs + helpers. Aucune spec n'importe src/ (verifie) -> projet independant,
  // pas de reference vers tsconfig.app.json.
  "include": ["e2e"]
}
