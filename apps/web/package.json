{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fields": "node ../../tools/lint-no-hardcoded-fields.mjs",
    "lint:colors": "node ../../tools/lint-no-hardcoded-colors.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "generate-types": "openapi-typescript ../../apps/go-api/api/openapi.yaml -o src/lib/api/generated.ts",
    "analyze": "ANALYZE=true vite build",
    "knip": "knip"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-query-devtools": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "hls.js": "^1.7.4",
    "intl-messageformat": "^11.2.14",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iarna/toml": "^2.2.5",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.0.1",
    "knip": "^6.44.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "opus-decoder": "^0.7.12",
    "rollup-plugin-visualizer": "^7.1.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "brace-expansion": "^5.0.9",
    "postcss-selector-parser": "^7.1.6",
    "@redocly/openapi-core": {
      "minimatch": {
        "brace-expansion": "^2.1.4"
      }
    }
  }
}
