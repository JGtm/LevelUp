# Logs (ancré /logs : le pattern bare « logs » du template Vite matchait à
# toutes profondeurs et excluait par erreur src/features/admin/logs/ — code
# source du viewer de logs admin).
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# TanStack Router generated files
.tanstack/tmp/

# Playwright artefacts
test-results/
playwright-report/
tests/e2e-results/
playwright/.cache/

# Bug-guard : Playwright écrit parfois son cache sous "undefined/temp/..."
# quand une variable d'env de chemin n'est pas résolue. Ne pas tracker.
undefined/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
