+
+// rc2Vider (instruction du lot L4a, 2026-10-03, hors depot) : paquets dont le statut ou les utiles
+// different entre `full` et `full-L4a`, dans CAMPAGNE_RCOMB2_DUMP.
+func rc2Vider(id string, res []*rc2Res) {
+	d := os.Getenv("CAMPAGNE_RCOMB2_DUMP")
+	if d == "" {
+		return
+	}
+	var a, b *rc2Res
+	for _, r := range res {
+		switch r.nom {
+		case "full":
+			a = r
+		case "full-L4a":
+			b = r
+		}
+	}
+	if a == nil || b == nil || len(a.st) != len(b.st) {
+		fmt.Fprintf(os.Stderr, "dump impossible : %v %v\n", a == nil, b == nil)
+		return
+	}
+	var lignes []string
+	for i := range a.st {
+		if a.st[i] != b.st[i] || a.ut[i] != b.ut[i] {
+			lignes = append(lignes, fmt.Sprintf("%s\t%s\t%d\t%d\t%d\t%d", id, a.cles[i], a.st[i], a.ut[i], b.st[i], b.ut[i]))
+		}
+	}
+	_ = os.WriteFile(d+"/"+id+".detail.txt", []byte("== full\n"+a.detail+"== full-L4a\n"+b.detail), 0o600)
+	_ = os.WriteFile(d+"/"+id+".tsv", []byte("film\tpaquet\tst_full\tut_full\tst_sans_L4a\tut_sans_L4a\n"+strings.Join(lignes, "\n")+"\n"), 0o600)
+}
+
+// rc2Detailler decrit un paquet : debut de liste, fermeture, records (instruction L4a, hors depot).
+func rc2Detailler(p *cmPaquet) string {
+	s := fmt.Sprintf("debut=%d strict=%d ferme=%v utiles_fermes=%d recs=%d\n", p.debut, p.strict, p.d.Fermee, p.utilesFermes, len(p.recs))
+	for i, r := range p.recs {
+		var comps []string
+		for _, c := range r.Trace.Comps {
+			comps = append(comps, strconv.Itoa(c.Index))
+		}
+		s += fmt.Sprintf("  #%d type=%d slot=%d eid=%#x ti=%d desync=%d hdr=%d fin=%d comps=[%s]\n", i, r.Type, r.Slot, r.ID,
+			r.TypeIndex, r.DesyncAt, r.HeaderBit, r.Trace.EndBit, strings.Join(comps, ","))
+	}
+	return s
+}
