+// c3Records : les en-tetes lus d un paquet des chunks 50 a 56 (enquete sur les paquets perdus).
+func c3Records(c int, p *cmPaquet) string {
+	if c < 50 || c > 56 {
+		return "-"
+	}
+	var b strings.Builder
+	for _, r := range p.recs {
+		fmt.Fprintf(&b, "%d:%d:%d:%d ", r.Type, r.Slot, r.TypeIndex, r.DesyncAt)
+	}
+	return b.String()
+}
