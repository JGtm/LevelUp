--- c4_sonde.go (fichier ajoute)
package grammar

// c4_sonde.go — SONDE DE MESURE (surcouche du controle de L2, point C4) : jamais dans le depot.
// Ecrit, si C4_DUMP est pose, une ligne par paquet de la marche des etats de mouvement (classe
// de la liste, verdict de la vue C), une par lecture d etat retenue et une par dotation de
// naissance (lue ou non, et ce qui la confirme).

import (
	"fmt"
	"os"
	"sync"
)

var (
	c4Once sync.Once
	c4F    *os.File
	c4Mu   sync.Mutex
	c4VueC LectureVueC
	c4Vu   bool
)

func c4Ecrire(format string, a ...any) {
	c4Once.Do(func() {
		if p := os.Getenv("C4_DUMP"); p != "" {
			c4F, _ = os.Create(p)
		}
	})
	if c4F == nil {
		return
	}
	c4Mu.Lock()
	defer c4Mu.Unlock()
	fmt.Fprintf(c4F, format+"\n", a...)
}
var c4Classe string
var c4Conf string
