#!/usr/bin/env bash
# scripts/git-hooks/pre-commit — Hook git ADR 0021 Phase 3.5
#
# Lance le gate shared_social uniquement si la modification touche les fichiers
# critiques (pool, persist, media, ops/media, migration shared_social).
#
# Installation : make install-git-hooks (ou symlink manuel)
#
# Bypass exceptionnel : `git commit --no-verify` (déconseillé hors urgence).

set -euo pipefail

# Détecte les fichiers Go critiques modifiés dans le commit.
CRITICAL_PATTERN='apps/go-api/internal/platform/(duckdb|dblease)|apps/go-api/internal/persist|apps/go-api/internal/ops/media|apps/go-api/internal/migration/steps_shared_social|apps/go-api/internal/api/post_sync|apps/go-api/cmd/(rebuild|snapshot)_shared_social'

CHANGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$CRITICAL_PATTERN" || true)

if [ -z "$CHANGED" ]; then
    # Aucun fichier critique touché — skip le gate.
    exit 0
fi

echo "[pre-commit] ADR 0021 gate : fichiers critiques modifiés :"
echo "$CHANGED" | sed 's/^/  /'
echo "[pre-commit] Lancement go-api-test-shared-social-gate..."

# msys2 ucrt64 pour CGO si pas déjà dans le PATH
if ! command -v gcc >/dev/null 2>&1; then
    export PATH="/c/msys64/ucrt64/bin:$PATH"
fi

if ! make go-api-test-shared-social-gate; then
    echo ""
    echo "[pre-commit] ÉCHEC du gate ADR 0021."
    echo "  Soit : (a) corriger le code, soit (b) bypass avec 'git commit --no-verify'"
    echo "         (mais documenter pourquoi dans le message de commit)."
    exit 1
fi

echo "[pre-commit] Gate ADR 0021 OK"
exit 0
